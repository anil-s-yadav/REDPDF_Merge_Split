<!-- Debug manifest — merged with main AndroidManifest.xml for DEBUG builds only.
     INTERNET permission required for Flutter hot reload / debugging.
     AdMob App ID overridden to Google's official Test App ID (safe, test ads only). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required for Flutter hot reload -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- AdMob Test App ID — overrides main manifest in debug builds -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"
            tools:replace="android:value" />
    </application>
</manifest>
